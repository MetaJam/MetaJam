linters: linters_with_defaults(
    # Keep default naming styles first, then add MetaJam's conventions.
    object_name_linter = object_name_linter(
      styles = c(
        # lintr defaults
        "snake_case", "symbols",
        # MetaJam additions
        "camelCase", "dotted.case"
      )
    ),
    # Air and lintr disagree on valid indentation, causing style warnings.
    # Let Air control indentation.
    indentation_linter = NULL,
    # This linter mistakes explanatory examples and source references for code.
    # Keep those comments without false-positive warnings.
    commented_code_linter = NULL
  )
exclusions: list(
    # Skip files generated by the jamovi compiler.
    "R/*.h.R",
    "R/00jmv.R"
  )
